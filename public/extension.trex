<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.entreprise.advanced-table" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description resource-id="description"/>
    <author name="xxxx" email="xx.xxx@xxx.com" organization="xxx" website="https://xxx.com"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>https://idir-aj.github.io/tableau-advanced-table-viz-extension/</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Table Extension</text>
    </resource>
    <resource id="description">
      <text locale="en_US">Custom table with foldable hierarchy, bars, and D3 sparklines.</text>
    </resource>
  </resources>
</manifest>
